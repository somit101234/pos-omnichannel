generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ──────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  CASHIER
}

enum TransactionType {
  SALE
  PURCHASE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  E_WALLET
}

enum Platform {
  SHOPEE
  GRABFOOD
  BEOFORD
}

enum OnlineOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  RECEIVED
  CANCELLED
}

enum ShiftStatus {
  OPEN
  CLOSED
  INTERRUPTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  TRANSFER
}

enum AuditEntityType {
  USER
  PRODUCT
  STORE
  TRANSACTION
  CATEGORY
  STOCK
  SUPPLIER
  PURCHASE_ORDER
  SHIFT
  ONLINE_ORDER
}

// ── MODELS ─────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  passwordHash   String
  email          String?
  phone          String?
  role           Role     @default(CASHIER)
  isActive       Boolean  @default(true)
  loginAttempts  Int      @default(0)
  lockedUntil    DateTime?
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id])
  transactions   Transaction[]
  cashShifts     Shift[]  @relation("CashierShift")
  auditLogs      AuditLog[]
  created_AT     DateTime @default(now())
  updated_AT     DateTime @updatedAt

  @@index([storeId])
}

model Store {
  id          String    @id @default(cuid())
  name        String
  address     String?
  phone       String?
  taxCode     String?
  settings    Json?
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])
  products    Product[]
  categories  Category[]
  stocks      Stock[]
  transactions Transaction[]
  shifts      Shift[]   @relation("StoreShift")
  onlineOrders OnlineOrder[]
  purchaseOrders PurchaseOrder[]
  auditLogs   AuditLog[]
  users       User[]
  warehouses  Warehouse[]
  created_AT  DateTime  @default(now())
  updated_AT  DateTime  @updatedAt

  @@index([storeId]) // kept for plan compat; storeId = id
}

model Warehouse {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  address   String?
  products  Stock[]
  created_AT DateTime @default(now())
  updated_AT DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  name        String
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  created_AT  DateTime  @default(now())
  updated_AT  DateTime  @updatedAt

  @@index([storeId])
}

model Product {
  id            String        @id @default(cuid())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id])
  name          String
  barcode       String?       @unique
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  unit          String        @default("item")
  costPrice     BigInt        @default(0)    // cents
  salePrice     BigInt        @default(0)    // cents
  minStock      Int           @default(0)
  isBom         Boolean       @default(false)
  bomLevel      Int           @default(0)
  bomParentId   String?
  bomParent     Product?      @relation("BomParent", fields: [bomParentId], references: [id])
  bomChildren   Product[]     @relation("BomParent")
  bomItems      BomItem[]
  stock         Stock[]
  transactions  TransactionItem[]
  created_AT    DateTime      @default(now())
  updated_AT    DateTime      @updatedAt

  @@index([storeId])
}

model BomItem {
  id                  String  @id @default(cuid())
  bomProductId        String
  bomProduct          Product @relation(fields: [bomProductId], references: [id])
  ingredientProductId String
  ingredientProduct   Product @relation(fields: [ingredientProductId], references: [id])
  quantity            Int
  bomLevel            Int     @default(1)

  @@unique([bomProductId, ingredientProductId])
}

model Stock {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Int
  lastUpdated DateTime @updatedAt

  @@unique([productId, warehouseId])
}

model Transaction {
  id              String            @id @default(cuid())
  storeId         String
  store           Store             @relation(fields: [storeId], references: [id])
  cashierId       String
  cashier         User              @relation(fields: [cashierId], references: [id])
  type            TransactionType   @default(SALE)
  status          TransactionStatus @default(PENDING)
  total           BigInt            @default(0)   // cents
  paymentMethod   PaymentMethod
  items           TransactionItem[]
  createdAt       DateTime          @default(now())

  @@index([storeId, createdAt])
}

model TransactionItem {
  id          String    @id @default(cuid())
  transactionId String
  transaction Transaction @relation(fields: [transactionId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Int
  price       BigInt    // cents per unit
  total       BigInt    // cents

  @@index([transactionId])
}

model Supplier {
  id             String         @id @default(cuid())
  name           String
  phone          String?
  address        String?
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id             String          @id @default(cuid())
  supplierId     String
  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  storeId        String
  store          Store           @relation(fields: [storeId], references: [id])
  status         PurchaseOrderStatus @default(DRAFT)
  items          Json?
  total          BigInt?
  createdAt      DateTime        @default(now())

  @@index([storeId])
}

model Shift {
  id             String          @id @default(cuid())
  storeId        String
  store          Store           @relation(fields: [storeId], references: [id])
  cashierId      String
  cashier        User            @relation(fields: [cashierId], references: [id])
  startTime      DateTime
  endTime        DateTime?
  status         ShiftStatus     @default(OPEN)
  totalSales     BigInt?         @default(0)  // cents

  @@index([storeId, startTime])
}

model OnlineOrder {
  id             String           @id @default(cuid())
  storeId        String
  store          Store            @relation(fields: [storeId], references: [id])
  platform       Platform
  orderNo        String           @unique
  status         OnlineOrderStatus @default(PENDING)
  platformFee    BigInt?
  items          Json?
  createdAt      DateTime         @default(now())

  @@index([storeId, createdAt])
}

model AuditLog {
  id             String          @id @default(cuid())
  storeId        String
  store          Store           @relation(fields: [storeId], references: [id])
  userId         String
  action         AuditAction
  entityType     AuditEntityType
  entityId       String
  createdAt      DateTime        @default(now())

  @@index([storeId, entityType, entityId])
}
