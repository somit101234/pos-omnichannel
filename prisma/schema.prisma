generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ──────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  CASHIER
}

enum TransactionType {
  SALE
  PURCHASE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  E_WALLET
}

enum Platform {
  SHOPEE
  GRABFOOD
  BEOFORD
}

enum OnlineOrderStatus {
  PENDING
  PROCESSING
  READY
  DELIVERED
  REJECTED
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  RECEIVED
  CANCELLED
}

enum ShiftStatus {
  OPEN
  CLOSED
  INTERRUPTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  TRANSFER
}

enum AuditEntityType {
  USER
  PRODUCT
  STORE
  TRANSACTION
  CATEGORY
  STOCK
  SUPPLIER
  PURCHASE_ORDER
  SHIFT
  ONLINE_ORDER
}

// ── MODELS ─────────────────────────────────────────────────────────────────

model User {
  id             String         @id @default(cuid())
  username       String         @unique
  passwordHash   String
  email          String?
  phone          String?
  role           Role           @default(CASHIER)
  isActive       Boolean        @default(true)
  loginAttempts  Int            @default(0)
  lockedUntil    DateTime?
  storeId        String
  store          Store          @relation("StoreUsers", fields: [storeId], references: [id])
  transactions   Transaction[]  @relation("TransactionCashier")
  cashierShifts  Shift[]        @relation("CashierShift")
  auditLogs      AuditLog[]     @relation("AuditLogUser")
  ownedStores    Store[]        @relation("StoreOwner")
  created_AT     DateTime       @default(now())
  updated_AT     DateTime       @updatedAt

  @@index([storeId])
}

model Store {
  id            String     @id @default(cuid())
  name          String
  address       String?
  phone         String?
  taxCode       String?
  settings      Json?
  ownerId       String
  owner         User       @relation("StoreOwner", fields: [ownerId], references: [id])
  products      Product[]  @relation("ProductStore")
  categories    Category[] @relation("CategoryStore")
  transactions  Transaction[] @relation("TransactionStore")
  shifts        Shift[]    @relation("StoreShift")
  onlineOrders  OnlineOrder[] @relation("OOStore")
  purchaseOrders PurchaseOrder[] @relation("POStore")
  auditLogs     AuditLog[] @relation("ALStore")
  storeUsers    User[]     @relation("StoreUsers")
  warehouses    Warehouse[] @relation("WarehouseStore")
  created_AT    DateTime   @default(now())
  updated_AT    DateTime   @updatedAt
}

model Warehouse {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation("WarehouseStore", fields: [storeId], references: [id])
  name      String
  address   String?
  stocks    Stock[]   @relation("StockWarehouse")
  created_AT DateTime  @default(now())
  updated_AT DateTime  @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation("CategoryStore", fields: [storeId], references: [id])
  name        String
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[] @relation("ProductCategory")
  created_AT  DateTime  @default(now())
  updated_AT  DateTime  @updatedAt

  @@index([storeId])
}

model Product {
  id            String        @id @default(cuid())
  storeId       String
  store         Store         @relation("ProductStore", fields: [storeId], references: [id])
  name          String
  barcode       String?       @unique
  categoryId    String
  category      Category      @relation("ProductCategory", fields: [categoryId], references: [id])
  unit          String        @default("item")
  costPrice     BigInt        @default(0)    // cents
  salePrice     BigInt        @default(0)    // cents
  minStock      Int           @default(0)
  isBom         Boolean       @default(false)
  bomLevel      Int           @default(0)
  bomParentId   String?
  bomParent     Product?      @relation("BomParent", fields: [bomParentId], references: [id])
  bomChildren   Product[]     @relation("BomParent")
  bomIngredients BomItem[]    @relation("BomProductIngredients")
  ingredientOf  BomItem[]     @relation("BomIngredients")
  unitConversions UnitConversion[] @relation("ProductUnitConversions")
  stocks        Stock[]       @relation("StockProduct")
  transactionItems TransactionItem[] @relation("TransactionItemProduct")
  created_AT    DateTime      @default(now())
  updated_AT    DateTime      @updatedAt

  @@index([storeId])
}

model BomItem {
  id                  String  @id @default(cuid())
  bomProductId        String
  bomProduct          Product @relation("BomProductIngredients", fields: [bomProductId], references: [id])
  ingredientProductId String
  ingredientProduct   Product @relation("BomIngredients", fields: [ingredientProductId], references: [id])
  quantity            Int
  bomLevel            Int     @default(1)

  @@unique([bomProductId, ingredientProductId])
}

model Stock {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation("StockProduct", fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation("StockWarehouse", fields: [warehouseId], references: [id])
  quantity    Int
  lastUpdated DateTime @updatedAt

  @@unique([productId, warehouseId])
}

model Transaction {
  id              String            @id @default(cuid())
  storeId         String
  store           Store             @relation("TransactionStore", fields: [storeId], references: [id])
  cashierId       String
  cashier         User              @relation("TransactionCashier", fields: [cashierId], references: [id])
  type            TransactionType   @default(SALE)
  status          TransactionStatus @default(PENDING)
  total           BigInt            @default(0)   // cents
  paymentMethod   PaymentMethod
  transactionItems TransactionItem[] @relation("TransactionItems")
  platformFeeRate Float?            // platform fee rate (e.g. 0.15 = 15%), used by ReportsService
  createdAt       DateTime          @default(now())

  @@index([storeId, createdAt])
}

model TransactionItem {
  id             String  @id @default(cuid())
  transactionId  String
  transaction    Transaction @relation("TransactionItems", fields: [transactionId], references: [id])
  productId      String
  product        Product @relation("TransactionItemProduct", fields: [productId], references: [id])
  quantity       Int
  price          BigInt  // cents per unit
  total          BigInt  // cents

  @@index([transactionId])
}

model Supplier {
  id             String         @id @default(cuid())
  name           String
  phone          String?
  address        String?
  purchaseOrders PurchaseOrder[] @relation("POSupplier")
}

model PurchaseOrder {
  id             String          @id @default(cuid())
  supplierId     String
  supplier       Supplier        @relation("POSupplier", fields: [supplierId], references: [id])
  storeId        String
  store          Store           @relation("POStore", fields: [storeId], references: [id])
  status         PurchaseOrderStatus @default(DRAFT)
  items          Json?
  total          BigInt?
  createdAt      DateTime        @default(now())

  @@index([storeId])
}

model Shift {
  id             String          @id @default(cuid())
  storeId        String
  store          Store           @relation("StoreShift", fields: [storeId], references: [id])
  cashierId      String
  cashier        User            @relation("CashierShift", fields: [cashierId], references: [id])
  startTime      DateTime
  endTime        DateTime?
  status         ShiftStatus     @default(OPEN)
  totalSales     BigInt?         @default(0)  // cents

  @@index([storeId, startTime])
}

model OnlineOrder {
  id               String            @id @default(cuid())
  storeId          String
  store            Store             @relation("OOStore", fields: [storeId], references: [id])
  platform         Platform
  orderNo          String            @unique
  customerId       String
  status           OnlineOrderStatus @default(PENDING)
  platformFee      BigInt?
  items            Json?
  rejectionReason  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([storeId, createdAt])
}

model AuditLog {
  id             String          @id @default(cuid())
  storeId        String
  store          Store           @relation("ALStore", fields: [storeId], references: [id])
  userId         String
  user           User            @relation("AuditLogUser", fields: [userId], references: [id])
  action         AuditAction
  entityType     AuditEntityType
  entityId       String
  createdAt      DateTime        @default(now())

  @@index([storeId, entityType, entityId])
}

// ── UNIT CONVERSION ──────────────────────────────────────────────────────────
// Ví dụ: 1 nồi = 20 hộp, ratio = 20; 1 kg = 1000 g, ratio = 1000

model UnitConversion {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation("ProductUnitConversions", fields: [productId], references: [id])
  fromUnit      String   // đơn vị gốc (kg, cái, nồi...)
  toUnit        String   // đơn vị mục tiêu (g, hộp, hộp...)
  ratio         Int      // tỷ lệ: từ từ_unit sang to_unit (ví dụ: 1 nồi = 20 hộp → ratio = 20)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId, fromUnit, toUnit])
  @@unique([productId, fromUnit, toUnit])
}
